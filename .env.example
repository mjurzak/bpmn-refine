# copy this file to .env and fill in the values
# NEVER commit .env to version control

ANTHROPIC_API_KEY=anthropic_key_here
OPENAI_API_KEY=openai_key_here
GEMINI_API_KEY=gemini_key_here

# optional overrides (defaults shown)
# LLM_PROVIDER=openai            # anthropic | openai | ollama | gemini | codex_cli | claude_cli
# LLM_STRONG_PROVIDER=openai
# LLM_FAST_PROVIDER=openai
# LLM_STRONG_MODEL=gpt-5.6-sol
# LLM_FAST_MODEL=gpt-5.6-luna

# Optional local CLI harnesses. Providers register only when these executables exist.
# CODEX_CLI_PATH=codex
# CLAUDE_CLI_PATH=claude
# LLM_CLI_TIMEOUT_SECONDS=300
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
