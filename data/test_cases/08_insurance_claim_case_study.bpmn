<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_insurance_claim"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_claim_handling" name="Insurance Claim Handling" isExecutable="false">

    <!-- main path -->
    <bpmn:startEvent id="start_claim" name="Claim Received">
      <bpmn:outgoing>sf_received</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="task_register" name="Register Claim">
      <bpmn:incoming>sf_received</bpmn:incoming>
      <bpmn:outgoing>sf_registered</bpmn:outgoing>
      <bpmn:outgoing>sf_ghost_target</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="gw_triage" name="Documents complete?">
      <bpmn:incoming>sf_registered</bpmn:incoming>
      <bpmn:outgoing>sf_complete</bpmn:outgoing>
      <bpmn:outgoing>sf_incomplete</bpmn:outgoing>
      <bpmn:outgoing>sf_escalate</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="task_assess" name="Assess Damage">
      <bpmn:incoming>sf_complete</bpmn:incoming>
      <bpmn:outgoing>sf_assessed</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="task_request_docs" name="Request Missing Documents">
      <bpmn:incoming>sf_incomplete</bpmn:incoming>
      <bpmn:outgoing>sf_docs_received</bpmn:outgoing>
    </bpmn:task>

    <bpmn:parallelGateway id="gw_sync" name="Synchronise">
      <bpmn:incoming>sf_assessed</bpmn:incoming>
      <bpmn:incoming>sf_docs_received</bpmn:incoming>
      <bpmn:outgoing>sf_synced</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:task id="task_payout" name="Pay Out Claim">
      <bpmn:incoming>sf_synced</bpmn:incoming>
      <bpmn:incoming>sf_fraud_clear</bpmn:incoming>
      <bpmn:incoming>sf_ghost_source</bpmn:incoming>
      <bpmn:outgoing>sf_paid</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="end_settled" name="Claim Settled">
      <bpmn:incoming>sf_paid</bpmn:incoming>
    </bpmn:endEvent>

    <!-- escalation branch was drawn but never routed onward (R008 trap) -->
    <bpmn:task id="task_escalate" name="Escalate to Supervisor">
      <bpmn:incoming>sf_escalate</bpmn:incoming>
    </bpmn:task>

    <!-- fraud check was meant to sit before payout; only its outgoing flow was
         ever drawn, so nothing activates it (R007 dead element) -->
    <bpmn:task id="task_fraud_check" name="Run Fraud Check">
      <bpmn:outgoing>sf_fraud_clear</bpmn:outgoing>
    </bpmn:task>

    <!-- appeal handling was started on the canvas and left unwired (R003) -->
    <bpmn:startEvent id="start_appeal" name="Appeal Received" />

    <!-- the rejection outcome was never connected to anything (R004) -->
    <bpmn:endEvent id="end_rejected" name="Claim Rejected" />

    <bpmn:sequenceFlow id="sf_received" sourceRef="start_claim" targetRef="task_register" />
    <bpmn:sequenceFlow id="sf_registered" sourceRef="task_register" targetRef="gw_triage" />

    <bpmn:sequenceFlow id="sf_complete" name="documents complete" sourceRef="gw_triage" targetRef="task_assess">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${documentsComplete == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="sf_incomplete" name="documents missing" sourceRef="gw_triage" targetRef="task_request_docs">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${documentsComplete == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="sf_escalate" name="dispute raised" sourceRef="gw_triage" targetRef="task_escalate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${disputeRaised == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="sf_assessed" sourceRef="task_assess" targetRef="gw_sync" />
    <bpmn:sequenceFlow id="sf_docs_received" sourceRef="task_request_docs" targetRef="gw_sync" />
    <bpmn:sequenceFlow id="sf_synced" sourceRef="gw_sync" targetRef="task_payout" />
    <bpmn:sequenceFlow id="sf_paid" sourceRef="task_payout" targetRef="end_settled" />
    <bpmn:sequenceFlow id="sf_fraud_clear" sourceRef="task_fraud_check" targetRef="task_payout" />

    <!-- 'Verify Coverage' was deleted from the model, its outgoing flow was not (R005) -->
    <bpmn:sequenceFlow id="sf_ghost_source" sourceRef="task_verify_coverage" targetRef="task_payout" />
    <!-- 'Notify Customer' was deleted from the model, the flow into it was not (R006) -->
    <bpmn:sequenceFlow id="sf_ghost_target" sourceRef="task_register" targetRef="task_notify_customer" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_claim">
    <bpmndi:BPMNPlane id="BPMNPlane_claim" bpmnElement="Process_claim_handling">

      <bpmndi:BPMNShape id="start_claim_di" bpmnElement="start_claim">
        <dc:Bounds x="160" y="222" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_register_di" bpmnElement="task_register">
        <dc:Bounds x="246" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_triage_di" bpmnElement="gw_triage" isMarkerVisible="true">
        <dc:Bounds x="396" y="215" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_assess_di" bpmnElement="task_assess">
        <dc:Bounds x="520" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_request_docs_di" bpmnElement="task_request_docs">
        <dc:Bounds x="520" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_escalate_di" bpmnElement="task_escalate">
        <dc:Bounds x="520" y="440" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_sync_di" bpmnElement="gw_sync">
        <dc:Bounds x="700" y="215" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_fraud_check_di" bpmnElement="task_fraud_check">
        <dc:Bounds x="810" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_payout_di" bpmnElement="task_payout">
        <dc:Bounds x="810" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_settled_di" bpmnElement="end_settled">
        <dc:Bounds x="980" y="222" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_appeal_di" bpmnElement="start_appeal">
        <dc:Bounds x="160" y="440" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_rejected_di" bpmnElement="end_rejected">
        <dc:Bounds x="980" y="440" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="sf_received_di" bpmnElement="sf_received">
        <di:waypoint x="196" y="240" />
        <di:waypoint x="246" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_registered_di" bpmnElement="sf_registered">
        <di:waypoint x="346" y="240" />
        <di:waypoint x="396" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_complete_di" bpmnElement="sf_complete">
        <di:waypoint x="421" y="215" />
        <di:waypoint x="421" y="100" />
        <di:waypoint x="520" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_incomplete_di" bpmnElement="sf_incomplete">
        <di:waypoint x="421" y="265" />
        <di:waypoint x="421" y="340" />
        <di:waypoint x="520" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_escalate_di" bpmnElement="sf_escalate">
        <di:waypoint x="446" y="240" />
        <di:waypoint x="470" y="240" />
        <di:waypoint x="470" y="480" />
        <di:waypoint x="520" y="480" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_assessed_di" bpmnElement="sf_assessed">
        <di:waypoint x="620" y="100" />
        <di:waypoint x="725" y="100" />
        <di:waypoint x="725" y="215" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_docs_received_di" bpmnElement="sf_docs_received">
        <di:waypoint x="620" y="340" />
        <di:waypoint x="725" y="340" />
        <di:waypoint x="725" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_synced_di" bpmnElement="sf_synced">
        <di:waypoint x="750" y="240" />
        <di:waypoint x="810" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_fraud_clear_di" bpmnElement="sf_fraud_clear">
        <di:waypoint x="860" y="140" />
        <di:waypoint x="860" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf_paid_di" bpmnElement="sf_paid">
        <di:waypoint x="910" y="240" />
        <di:waypoint x="980" y="240" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
