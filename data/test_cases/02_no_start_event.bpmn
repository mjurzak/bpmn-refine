<?xml version='1.0' encoding='UTF-8'?>
<!--
  CASE 02 — Missing start event: Invoice Approval
  Expected issues:
    R001 ERROR  — process has no start event

  Flow: Review Invoice → [Valid] Process Payment → Invoice Processed
                       → [Invalid] Return to Sender → Invoice Returned
  The process has no start event — it is unclear what triggers it.
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             id="def_invoice"
             targetNamespace="http://bpmn.io/schema/bpmn">
  <process id="proc_invoice" name="Invoice Approval" isExecutable="false">

    <task id="task_review" name="Review Invoice">
      <outgoing>f1</outgoing>
    </task>

    <exclusiveGateway id="gw_valid" name="Invoice Valid?">
      <incoming>f1</incoming>
      <outgoing>f2</outgoing>
      <outgoing>f3</outgoing>
    </exclusiveGateway>

    <task id="task_pay" name="Process Payment">
      <incoming>f2</incoming>
      <outgoing>f4</outgoing>
    </task>

    <task id="task_return" name="Return to Sender">
      <incoming>f3</incoming>
      <outgoing>f5</outgoing>
    </task>

    <endEvent id="end_processed" name="Invoice Processed">
      <incoming>f4</incoming>
    </endEvent>

    <endEvent id="end_returned" name="Invoice Returned">
      <incoming>f5</incoming>
    </endEvent>

    <sequenceFlow id="f1" sourceRef="task_review" targetRef="gw_valid"/>
    <sequenceFlow id="f2" name="Valid" sourceRef="gw_valid" targetRef="task_pay">
      <conditionExpression>valid == true</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f3" name="Invalid" sourceRef="gw_valid" targetRef="task_return">
      <conditionExpression>valid == false</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f4" sourceRef="task_pay" targetRef="end_processed"/>
    <sequenceFlow id="f5" sourceRef="task_return" targetRef="end_returned"/>

  </process>
  <bpmndi:BPMNDiagram id="diagram1">
    <bpmndi:BPMNPlane id="plane1" bpmnElement="proc_invoice">
      <bpmndi:BPMNShape id="task_review_di" bpmnElement="task_review">
        <dc:Bounds x="80" y="160" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_valid_di" bpmnElement="gw_valid" isMarkerVisible="true">
        <dc:Bounds x="240" y="175" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_pay_di" bpmnElement="task_pay">
        <dc:Bounds x="350" y="60" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_return_di" bpmnElement="task_return">
        <dc:Bounds x="350" y="260" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_processed_di" bpmnElement="end_processed">
        <dc:Bounds x="510" y="82" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_returned_di" bpmnElement="end_returned">
        <dc:Bounds x="510" y="282" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="180" y="200"/>
        <di:waypoint x="240" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="265" y="175"/>
        <di:waypoint x="265" y="100"/>
        <di:waypoint x="350" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
        <di:waypoint x="265" y="225"/>
        <di:waypoint x="265" y="300"/>
        <di:waypoint x="350" y="300"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4">
        <di:waypoint x="450" y="100"/>
        <di:waypoint x="510" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5">
        <di:waypoint x="450" y="300"/>
        <di:waypoint x="510" y="300"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
