<?xml version='1.0' encoding='UTF-8'?>
<!--
  CASE 01 — Valid baseline: Employee Onboarding
  Expected issues: none
  Rules exercised: all tier-1 rules pass (R001–R008)

  Flow: Application Received → Review Application → [Approved] Complete IT Setup → Employee Onboarded
                                                   → [Rejected] Send Rejection Notice → Application Rejected
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             id="def_onboarding"
             targetNamespace="http://bpmn.io/schema/bpmn">
  <process id="proc_onboarding" name="Employee Onboarding" isExecutable="false">

    <startEvent id="start1" name="Application Received">
      <outgoing>f1</outgoing>
    </startEvent>

    <task id="task_review" name="Review Application">
      <incoming>f1</incoming>
      <outgoing>f2</outgoing>
    </task>

    <exclusiveGateway id="gw_decision" name="Application Decision">
      <incoming>f2</incoming>
      <outgoing>f3</outgoing>
      <outgoing>f4</outgoing>
    </exclusiveGateway>

    <task id="task_setup" name="Complete IT Setup">
      <incoming>f3</incoming>
      <outgoing>f5</outgoing>
    </task>

    <task id="task_reject" name="Send Rejection Notice">
      <incoming>f4</incoming>
      <outgoing>f6</outgoing>
    </task>

    <endEvent id="end_success" name="Employee Onboarded">
      <incoming>f5</incoming>
    </endEvent>

    <endEvent id="end_rejected" name="Application Rejected">
      <incoming>f6</incoming>
    </endEvent>

    <sequenceFlow id="f1" sourceRef="start1" targetRef="task_review"/>
    <sequenceFlow id="f2" sourceRef="task_review" targetRef="gw_decision"/>
    <sequenceFlow id="f3" name="Approved" sourceRef="gw_decision" targetRef="task_setup">
      <conditionExpression>decision == "approved"</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f4" name="Rejected" sourceRef="gw_decision" targetRef="task_reject">
      <conditionExpression>decision == "rejected"</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f5" sourceRef="task_setup" targetRef="end_success"/>
    <sequenceFlow id="f6" sourceRef="task_reject" targetRef="end_rejected"/>

  </process>
  <bpmndi:BPMNDiagram id="diagram1">
    <bpmndi:BPMNPlane id="plane1" bpmnElement="proc_onboarding">
      <bpmndi:BPMNShape id="start1_di" bpmnElement="start1">
        <dc:Bounds x="80" y="182" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_review_di" bpmnElement="task_review">
        <dc:Bounds x="176" y="160" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_decision_di" bpmnElement="gw_decision" isMarkerVisible="true">
        <dc:Bounds x="336" y="175" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_setup_di" bpmnElement="task_setup">
        <dc:Bounds x="446" y="60" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_reject_di" bpmnElement="task_reject">
        <dc:Bounds x="446" y="260" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_success_di" bpmnElement="end_success">
        <dc:Bounds x="606" y="82" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_rejected_di" bpmnElement="end_rejected">
        <dc:Bounds x="606" y="282" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="116" y="200"/>
        <di:waypoint x="176" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="276" y="200"/>
        <di:waypoint x="336" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
        <di:waypoint x="361" y="175"/>
        <di:waypoint x="361" y="100"/>
        <di:waypoint x="446" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4">
        <di:waypoint x="361" y="225"/>
        <di:waypoint x="361" y="300"/>
        <di:waypoint x="446" y="300"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5">
        <di:waypoint x="546" y="100"/>
        <di:waypoint x="606" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f6_di" bpmnElement="f6">
        <di:waypoint x="546" y="300"/>
        <di:waypoint x="606" y="300"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
