<?xml version='1.0' encoding='UTF-8'?>
<!--
  CASE 04 — Multiple start events + disconnected elements: Purchase Request
  Expected issues:
    R002 WARNING — more than one start event (Emergency Request has no flow)
    R004 ERROR   — start event "Emergency Request" has no outgoing sequence flow
    R006 WARNING — task "Archive Old Requests" is fully disconnected

  Flow (main): Purchase Request Submitted → Review Request → [Budget OK] Approve Purchase → Purchase Approved
                                                           → [No Budget] Defer Request → Request Deferred
  start2 (Emergency Request) exists but leads nowhere.
  task_archive floats with no connections at all.
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             id="def_purchase"
             targetNamespace="http://bpmn.io/schema/bpmn">
  <process id="proc_purchase" name="Purchase Request" isExecutable="false">

    <startEvent id="start1" name="Purchase Request Submitted">
      <outgoing>f1</outgoing>
    </startEvent>

    <!-- this start event has no outgoing flow — R002 + R004 -->
    <startEvent id="start2" name="Emergency Request"/>

    <task id="task_review" name="Review Request">
      <incoming>f1</incoming>
      <outgoing>f2</outgoing>
    </task>

    <exclusiveGateway id="gw_budget" name="Budget Available?">
      <incoming>f2</incoming>
      <outgoing>f3</outgoing>
      <outgoing>f4</outgoing>
    </exclusiveGateway>

    <task id="task_approve" name="Approve Purchase">
      <incoming>f3</incoming>
      <outgoing>f5</outgoing>
    </task>

    <task id="task_defer" name="Defer Request">
      <incoming>f4</incoming>
      <outgoing>f6</outgoing>
    </task>

    <!-- fully disconnected — R006 -->
    <task id="task_archive" name="Archive Old Requests"/>

    <endEvent id="end_approved" name="Purchase Approved">
      <incoming>f5</incoming>
    </endEvent>

    <endEvent id="end_deferred" name="Request Deferred">
      <incoming>f6</incoming>
    </endEvent>

    <sequenceFlow id="f1" sourceRef="start1" targetRef="task_review"/>
    <sequenceFlow id="f2" sourceRef="task_review" targetRef="gw_budget"/>
    <sequenceFlow id="f3" name="Budget OK" sourceRef="gw_budget" targetRef="task_approve">
      <conditionExpression>budget >= requestAmount</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f4" name="No Budget" sourceRef="gw_budget" targetRef="task_defer">
      <conditionExpression>budget &lt; requestAmount</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f5" sourceRef="task_approve" targetRef="end_approved"/>
    <sequenceFlow id="f6" sourceRef="task_defer" targetRef="end_deferred"/>

  </process>
  <bpmndi:BPMNDiagram id="diagram1">
    <bpmndi:BPMNPlane id="plane1" bpmnElement="proc_purchase">
      <bpmndi:BPMNShape id="start1_di" bpmnElement="start1">
        <dc:Bounds x="80" y="182" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <!-- start2 floats above the main flow -->
      <bpmndi:BPMNShape id="start2_di" bpmnElement="start2">
        <dc:Bounds x="80" y="62" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_review_di" bpmnElement="task_review">
        <dc:Bounds x="176" y="160" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_budget_di" bpmnElement="gw_budget" isMarkerVisible="true">
        <dc:Bounds x="336" y="175" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_approve_di" bpmnElement="task_approve">
        <dc:Bounds x="446" y="60" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_defer_di" bpmnElement="task_defer">
        <dc:Bounds x="446" y="260" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <!-- task_archive floats bottom-right, visually isolated -->
      <bpmndi:BPMNShape id="task_archive_di" bpmnElement="task_archive">
        <dc:Bounds x="446" y="400" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_approved_di" bpmnElement="end_approved">
        <dc:Bounds x="606" y="82" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_deferred_di" bpmnElement="end_deferred">
        <dc:Bounds x="606" y="282" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="116" y="200"/>
        <di:waypoint x="176" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="276" y="200"/>
        <di:waypoint x="336" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
        <di:waypoint x="361" y="175"/>
        <di:waypoint x="361" y="100"/>
        <di:waypoint x="446" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4">
        <di:waypoint x="361" y="225"/>
        <di:waypoint x="361" y="300"/>
        <di:waypoint x="446" y="300"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5">
        <di:waypoint x="546" y="100"/>
        <di:waypoint x="606" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f6_di" bpmnElement="f6">
        <di:waypoint x="546" y="300"/>
        <di:waypoint x="606" y="300"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
