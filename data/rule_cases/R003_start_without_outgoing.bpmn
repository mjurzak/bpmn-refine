<?xml version='1.0' encoding='UTF-8'?>
<!--
  R003 — start event with no outgoing flow (class A: connectivity precondition).
  This is the real case that used to provoke the nonsensical "add an end event"
  auto-fix: a stray start event "Emergency request" with nothing attached. The
  main flow is well formed; only the orphan start trips a rule. Multiple start
  events are not flagged, so the second start produces no separate warning.
  Expected issues: R003 (error) on start_emergency.
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             id="def_R003" targetNamespace="http://bpmn.io/schema/bpmn">
  <process id="proc_R003" name="Start without outgoing" isExecutable="false">
    <startEvent id="start_main" name="Request submitted">
      <outgoing>f1</outgoing>
    </startEvent>
    <task id="task_review" name="Review request">
      <incoming>f1</incoming>
      <outgoing>f2</outgoing>
    </task>
    <endEvent id="end_done" name="Reviewed">
      <incoming>f2</incoming>
    </endEvent>
    <!-- orphan start event: declared but wired to nothing -->
    <startEvent id="start_emergency" name="Emergency request"/>
    <sequenceFlow id="f1" sourceRef="start_main" targetRef="task_review"/>
    <sequenceFlow id="f2" sourceRef="task_review" targetRef="end_done"/>
  </process>
</definitions>
