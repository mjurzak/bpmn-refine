<?xml version='1.0' encoding='UTF-8'?>
<!--
  R001 — no start event (class A: integrity / translation precondition).
  Nobody ever takes the order: the process describes baking and delivering but has
  no trigger, so it cannot be turned into a workflow net at all.
  R007 is suppressed here — with no entry anchor there is nothing to measure
  reachability from, and every node would spuriously echo R001.
  Expected: R001.
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             id="def_R001" targetNamespace="http://bpmn.io/schema/bpmn">
  <process id="proc_R001" name="Pizza order (no start)" isExecutable="false">
    <task id="task_bake" name="Bake pizza"><outgoing>f_baked</outgoing></task>
    <task id="task_deliver" name="Deliver pizza"><incoming>f_baked</incoming><outgoing>f_delivered</outgoing></task>
    <endEvent id="end_delivered" name="Pizza delivered"><incoming>f_delivered</incoming></endEvent>
    <sequenceFlow id="f_baked" sourceRef="task_bake" targetRef="task_deliver"/>
    <sequenceFlow id="f_delivered" sourceRef="task_deliver" targetRef="end_delivered"/>
  </process>
</definitions>
