<?xml version='1.0' encoding='UTF-8'?>
<!--
  R005 — sequence flow referencing an unknown source element (class A, error).
  A dangling reference cannot be rendered, executed, or translated to a net.
  Flow f_bad points its sourceRef at "ghost_node", which does not exist.
  Expected issues: R005 (error) on f_bad.
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             id="def_R005" targetNamespace="http://bpmn.io/schema/bpmn">
  <process id="proc_R005" name="Unknown source ref" isExecutable="false">
    <startEvent id="start_in" name="Start">
      <outgoing>f1</outgoing>
    </startEvent>
    <task id="task_work" name="Do the work">
      <incoming>f1</incoming>
      <outgoing>f2</outgoing>
    </task>
    <endEvent id="end_ok" name="Done">
      <incoming>f2</incoming>
    </endEvent>
    <sequenceFlow id="f1" sourceRef="start_in" targetRef="task_work"/>
    <sequenceFlow id="f2" sourceRef="task_work" targetRef="end_ok"/>
    <!-- sourceRef points at a node that does not exist -->
    <sequenceFlow id="f_bad" sourceRef="ghost_node" targetRef="task_work"/>
  </process>
</definitions>
