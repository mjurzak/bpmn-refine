<?xml version='1.0' encoding='UTF-8'?>
<!--
  R004 — end event with no incoming flow (class A: connectivity precondition).
  A second "Pizza delivered" end event sits on the canvas: a copy-paste leftover
  naming an outcome the process already reaches through end_delivered. Nothing
  routes to the copy, so the process can never terminate there.

  The duplicate framing is deliberate. An orphan naming a *new* outcome
  ("Order cancelled") makes the defect ambiguous — it reads as missing routing,
  and repairing it that way means inventing a decision point and a condition the
  model never stated. Here the outcome already exists and is already reachable,
  so there is no intent to recover and deletion is the only repair that leaves
  the process behaviour unchanged.

  The orphan is isolated, so R007/R008 correctly skip it.
  Expected: R004 on end_delivered_copy.
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             id="def_R004" targetNamespace="http://bpmn.io/schema/bpmn">
  <process id="proc_R004" name="Pizza order (stray end event)" isExecutable="false">
    <startEvent id="start_order" name="Order received"><outgoing>f_ordered</outgoing></startEvent>
    <task id="task_bake" name="Bake pizza"><incoming>f_ordered</incoming><outgoing>f_baked</outgoing></task>
    <task id="task_deliver" name="Deliver pizza"><incoming>f_baked</incoming><outgoing>f_delivered</outgoing></task>
    <endEvent id="end_delivered" name="Pizza delivered"><incoming>f_delivered</incoming></endEvent>
    <!-- leftover copy of the terminal state above; nothing leads to it -->
    <endEvent id="end_delivered_copy" name="Pizza delivered"/>
    <sequenceFlow id="f_ordered" sourceRef="start_order" targetRef="task_bake"/>
    <sequenceFlow id="f_baked" sourceRef="task_bake" targetRef="task_deliver"/>
    <sequenceFlow id="f_delivered" sourceRef="task_deliver" targetRef="end_delivered"/>
  </process>
</definitions>
