<?xml version='1.0' encoding='UTF-8'?>
<!--
  R007 fixed — the step is spliced into the main line.
  Repair: redirect the flow out of "Bake pizza" so it enters "Add extra cheese",
  which already flowed onward to delivery. One flow retargeted.
  Deleting task_extra would also clear the rule but discards a step the modeller
  clearly meant to perform. No quick fix is registered for R007; this comes from
  the LLM.
  Expected: none.
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             id="def_R007" targetNamespace="http://bpmn.io/schema/bpmn">
  <process id="proc_R007" name="Pizza order (dead step)" isExecutable="false">
    <startEvent id="start_order" name="Order received"><outgoing>f_ordered</outgoing></startEvent>
    <task id="task_bake" name="Bake pizza"><incoming>f_ordered</incoming><outgoing>f_baked</outgoing></task>
    <task id="task_extra" name="Add extra cheese"><incoming>f_baked</incoming><outgoing>f_extra</outgoing></task>
    <task id="task_deliver" name="Deliver pizza"><incoming>f_extra</incoming><outgoing>f_delivered</outgoing></task>
    <endEvent id="end_delivered" name="Pizza delivered"><incoming>f_delivered</incoming></endEvent>
    <sequenceFlow id="f_ordered" sourceRef="start_order" targetRef="task_bake"/>
    <sequenceFlow id="f_baked" sourceRef="task_bake" targetRef="task_extra"/>
    <sequenceFlow id="f_extra" sourceRef="task_extra" targetRef="task_deliver"/>
    <sequenceFlow id="f_delivered" sourceRef="task_deliver" targetRef="end_delivered"/>
  </process>
</definitions>
