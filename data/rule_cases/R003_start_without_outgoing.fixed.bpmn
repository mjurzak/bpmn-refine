<?xml version='1.0' encoding='UTF-8'?>
<!--
  R003 fixed — the phone intake now feeds the process.
  Repair chosen: connect start_phone to "Bake pizza", preserving the modeller's
  evident intent that orders arrive by two channels. Deleting start_phone is an
  equally minimal repair (one op either way) but discards that intent.
  Note: R003 has no registered quick fix — it was removed 2026-07-21 because the
  heuristic could only ever pick a node that was itself disconnected. This repair
  comes from the LLM, which is the only layer with enough context to weigh
  connecting against deleting.
  Expected: none.
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             id="def_R003" targetNamespace="http://bpmn.io/schema/bpmn">
  <process id="proc_R003" name="Pizza order (unwired intake)" isExecutable="false">
    <startEvent id="start_order" name="Online order"><outgoing>f_ordered</outgoing></startEvent>
    <task id="task_bake" name="Bake pizza">
      <incoming>f_ordered</incoming><incoming>f_phone</incoming><outgoing>f_baked</outgoing>
    </task>
    <task id="task_deliver" name="Deliver pizza"><incoming>f_baked</incoming><outgoing>f_delivered</outgoing></task>
    <endEvent id="end_delivered" name="Pizza delivered"><incoming>f_delivered</incoming></endEvent>
    <startEvent id="start_phone" name="Phone order"><outgoing>f_phone</outgoing></startEvent>
    <sequenceFlow id="f_ordered" sourceRef="start_order" targetRef="task_bake"/>
    <sequenceFlow id="f_phone" sourceRef="start_phone" targetRef="task_bake"/>
    <sequenceFlow id="f_baked" sourceRef="task_bake" targetRef="task_deliver"/>
    <sequenceFlow id="f_delivered" sourceRef="task_deliver" targetRef="end_delivered"/>
  </process>
</definitions>
