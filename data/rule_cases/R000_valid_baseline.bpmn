<?xml version='1.0' encoding='UTF-8'?>
<!--
  R000 — valid baseline. Produces NO issues.
  Guards against over-firing: it deliberately contains the shapes that used to be
  flagged and no longer are — two start events (BPMN permits them), an exclusive
  merge with two incoming flows, and an exclusive split with one condition plus a
  declared default.
  Expected issues: none.
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             id="def_R000" targetNamespace="http://bpmn.io/schema/bpmn">
  <process id="proc_R000" name="Pizza order (valid)" isExecutable="false">
    <startEvent id="start_online" name="Online order"><outgoing>f_online</outgoing></startEvent>
    <startEvent id="start_phone" name="Phone order"><outgoing>f_phone</outgoing></startEvent>
    <exclusiveGateway id="gw_intake" name="Intake">
      <incoming>f_online</incoming><incoming>f_phone</incoming><outgoing>f_taken</outgoing>
    </exclusiveGateway>
    <task id="task_take" name="Take order"><incoming>f_taken</incoming><outgoing>f_checked</outgoing></task>
    <exclusiveGateway id="gw_stock" name="Ingredients in stock?" default="f_out_of_stock">
      <incoming>f_checked</incoming><outgoing>f_in_stock</outgoing><outgoing>f_out_of_stock</outgoing>
    </exclusiveGateway>
    <task id="task_bake" name="Bake pizza"><incoming>f_in_stock</incoming><outgoing>f_baked</outgoing></task>
    <task id="task_deliver" name="Deliver pizza"><incoming>f_baked</incoming><outgoing>f_delivered</outgoing></task>
    <task id="task_refund" name="Refund customer"><incoming>f_out_of_stock</incoming><outgoing>f_refunded</outgoing></task>
    <endEvent id="end_delivered" name="Pizza delivered"><incoming>f_delivered</incoming></endEvent>
    <endEvent id="end_refunded" name="Order refunded"><incoming>f_refunded</incoming></endEvent>
    <sequenceFlow id="f_online" sourceRef="start_online" targetRef="gw_intake"/>
    <sequenceFlow id="f_phone" sourceRef="start_phone" targetRef="gw_intake"/>
    <sequenceFlow id="f_taken" sourceRef="gw_intake" targetRef="task_take"/>
    <sequenceFlow id="f_checked" sourceRef="task_take" targetRef="gw_stock"/>
    <sequenceFlow id="f_in_stock" sourceRef="gw_stock" targetRef="task_bake">
      <conditionExpression>inStock</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f_out_of_stock" sourceRef="gw_stock" targetRef="task_refund"/>
    <sequenceFlow id="f_baked" sourceRef="task_bake" targetRef="task_deliver"/>
    <sequenceFlow id="f_delivered" sourceRef="task_deliver" targetRef="end_delivered"/>
    <sequenceFlow id="f_refunded" sourceRef="task_refund" targetRef="end_refunded"/>
  </process>
</definitions>
