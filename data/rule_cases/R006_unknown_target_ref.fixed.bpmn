<?xml version='1.0' encoding='UTF-8'?>
<!--
  R006 fixed — the leftover flow is removed.
  Repair: delete f_ghost. This is what the deterministic quick fix produces.
  Expected: none.
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             id="def_R006" targetNamespace="http://bpmn.io/schema/bpmn">
  <process id="proc_R006" name="Pizza order (deleted target)" isExecutable="false">
    <startEvent id="start_order" name="Order received"><outgoing>f_ordered</outgoing></startEvent>
    <task id="task_bake" name="Bake pizza"><incoming>f_ordered</incoming><outgoing>f_baked</outgoing></task>
    <task id="task_deliver" name="Deliver pizza"><incoming>f_baked</incoming><outgoing>f_delivered</outgoing></task>
    <endEvent id="end_delivered" name="Pizza delivered"><incoming>f_delivered</incoming></endEvent>
    <sequenceFlow id="f_ordered" sourceRef="start_order" targetRef="task_bake"/>
    <sequenceFlow id="f_baked" sourceRef="task_bake" targetRef="task_deliver"/>
    <sequenceFlow id="f_delivered" sourceRef="task_deliver" targetRef="end_delivered"/>
  </process>
</definitions>
