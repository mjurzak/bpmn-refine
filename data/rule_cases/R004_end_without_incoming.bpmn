<?xml version='1.0' encoding='UTF-8'?>
<!--
  R004 — end event with no incoming flow (class A: connectivity precondition).
  An unreachable end can never terminate the process.
  Expected issues: R004 (error) on end_unreachable.
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             id="def_R004" targetNamespace="http://bpmn.io/schema/bpmn">
  <process id="proc_R004" name="End without incoming" isExecutable="false">
    <startEvent id="start_in" name="Start">
      <outgoing>f1</outgoing>
    </startEvent>
    <task id="task_work" name="Do the work">
      <incoming>f1</incoming>
      <outgoing>f2</outgoing>
    </task>
    <endEvent id="end_ok" name="Completed">
      <incoming>f2</incoming>
    </endEvent>
    <!-- declared end with no incoming flow -->
    <endEvent id="end_unreachable" name="Cancelled"/>
    <sequenceFlow id="f1" sourceRef="start_in" targetRef="task_work"/>
    <sequenceFlow id="f2" sourceRef="task_work" targetRef="end_ok"/>
  </process>
</definitions>
