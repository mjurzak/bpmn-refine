<?xml version='1.0' encoding='UTF-8'?>
<!--
  R008 — connected node that cannot reach any end event (class B, error). A trap:
  the process can enter task_dead but can never complete from there. Like R007
  this is an exact under-approximation of soundness. task_dead is reachable from
  the start (via the gateway) but has no outgoing flow, so no end is reachable.
  Expected issues: R008 (error) on task_dead.
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             id="def_R008" targetNamespace="http://bpmn.io/schema/bpmn">
  <process id="proc_R008" name="Trap node" isExecutable="false">
    <startEvent id="start_in" name="Start">
      <outgoing>f1</outgoing>
    </startEvent>
    <task id="task_triage" name="Triage">
      <incoming>f1</incoming>
      <outgoing>f2</outgoing>
    </task>
    <exclusiveGateway id="gw_route" name="Resolvable?">
      <incoming>f2</incoming>
      <outgoing>f_ok</outgoing>
      <outgoing>f_dead</outgoing>
    </exclusiveGateway>
    <task id="task_resolve" name="Resolve">
      <incoming>f_ok</incoming>
      <outgoing>f3</outgoing>
    </task>
    <endEvent id="end_ok" name="Resolved">
      <incoming>f3</incoming>
    </endEvent>
    <!-- reachable, but goes nowhere: a dead end / trap -->
    <task id="task_dead" name="Park indefinitely">
      <incoming>f_dead</incoming>
    </task>
    <sequenceFlow id="f1" sourceRef="start_in" targetRef="task_triage"/>
    <sequenceFlow id="f2" sourceRef="task_triage" targetRef="gw_route"/>
    <sequenceFlow id="f_ok" sourceRef="gw_route" targetRef="task_resolve">
      <conditionExpression>resolvable</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f_dead" sourceRef="gw_route" targetRef="task_dead">
      <conditionExpression>not resolvable</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f3" sourceRef="task_resolve" targetRef="end_ok"/>
  </process>
</definitions>
