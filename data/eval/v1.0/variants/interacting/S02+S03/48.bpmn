  <process id="Process_1" isExecutable="false">
    <userTask id="UserTask_1" name="select a starting block">
      <outgoing>SequenceFlow_19</outgoing>
      <incoming>SequenceFlow_1</incoming>
    </userTask>
    <userTask id="UserTask_2" name="get your starting number">
      <outgoing>SequenceFlow_9</outgoing>
      <incoming>SequenceFlow_18</incoming>
    </userTask>
    <serviceTask id="ServiceTask_1" name="measure the time">
      <outgoing>SequenceFlow_5</outgoing>
      <incoming>SequenceFlow_3</incoming>
    </serviceTask>
    <serviceTask id="ServiceTask_2" name="receive your final running time">
      <incoming>SequenceFlow_12</incoming>
    </serviceTask>
