<?xml version='1.0' encoding='UTF-8'?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Process_1" isExecutable="false">
    <task id="Task_1" name="Employee submits a vacation request">
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <task id="Task_2" name="Requirement is registered">
      <outgoing>SequenceFlow_3</outgoing>
      <incoming>SequenceFlow_2</incoming>
    </task>
    <task id="Task_3" name="Employee's supervisor receive the request">
      <outgoing>SequenceFlow_4</outgoing>
    </task>
    <task id="Task_4" name="Supervisor approve or reject the request">
      <outgoing>SequenceFlow_5</outgoing>
      <incoming>SequenceFlow_4</incoming>
    </task>
    <task id="Task_5" name="Application is returned to employee">
      <outgoing>SequenceFlow_11</outgoing>
      <incoming>SequenceFlow_9</incoming>
    </task>
    <task id="Task_6" name="Notification is generated to the HR Representative">
      <outgoing>SequenceFlow_6</outgoing>
      <incoming>SequenceFlow_10</incoming>
    </task>
    <task id="Task_7" name="HR Representative complete the respective management procedures">
      <outgoing>SequenceFlow_7</outgoing>
      <incoming>SequenceFlow_6</incoming>
    </task>
    <task id="Task_8" name="Employee can check rejection reasons">
      <outgoing>SequenceFlow_12</outgoing>
      <incoming>SequenceFlow_11</incoming>
    </task>
    <exclusiveGateway id="ExclusiveGateway_1">
      <outgoing>SequenceFlow_9</outgoing>
      <outgoing>SequenceFlow_10</outgoing>
      <incoming>SequenceFlow_5</incoming>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_2">
      <outgoing>SequenceFlow_8</outgoing>
      <incoming>SequenceFlow_7</incoming>
      <incoming>SequenceFlow_12</incoming>
    </exclusiveGateway>
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_8</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="Task_2"/>
    <sequenceFlow id="SequenceFlow_3" sourceRef="Task_2" targetRef="Missing_SequenceFlow_3_target_ref"/>
    <sequenceFlow id="SequenceFlow_4" sourceRef="Task_3" targetRef="Task_4"/>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_4" targetRef="ExclusiveGateway_1"/>
    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_6" targetRef="Task_7"/>
    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_7" targetRef="ExclusiveGateway_2"/>
    <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_2" targetRef="EndEvent_1"/>
    <sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_1" targetRef="Task_5" name="rejected"/>
    <sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_1" targetRef="Task_6" name="approved"/>
    <sequenceFlow id="SequenceFlow_11" sourceRef="Task_5" targetRef="Task_8"/>
    <sequenceFlow id="SequenceFlow_12" sourceRef="Task_8" targetRef="ExclusiveGateway_2"/>
  </process>
