<?xml version='1.0' encoding='UTF-8'?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Process_1" isExecutable="false">
    <task id="Task_1" name="MSPN sends a dismissal to MSPO">
      <outgoing>SequenceFlow_2</outgoing>
      <incoming>SequenceFlow_1</incoming>
    </task>
    <task id="Task_2" name="MSPO reviews the dismissal">
      <outgoing>SequenceFlow_3</outgoing>
      <incoming>SequenceFlow_2</incoming>
    </task>
    <task id="Task_3" name="MSPO rejects the dismissal of the MSPN">
      <outgoing>SequenceFlow_6</outgoing>
      <incoming>SequenceFlow_4</incoming>
    </task>
    <task id="Task_4" name="MSPO confirms the dismissal of the MSPN">
      <outgoing>SequenceFlow_7</outgoing>
      <incoming>SequenceFlow_5</incoming>
    </task>
    <exclusiveGateway id="ExclusiveGateway_1">
      <outgoing>SequenceFlow_4</outgoing>
      <outgoing>SequenceFlow_5</outgoing>
      <incoming>SequenceFlow_3</incoming>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_2">
      <outgoing>SequenceFlow_8</outgoing>
      <incoming>SequenceFlow_7</incoming>
    </exclusiveGateway>
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_8</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
