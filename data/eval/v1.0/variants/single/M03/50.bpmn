        <omgdi:waypoint x="500" y="295"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow_8_di" bpmnElement="SequenceFlow_8">
        <omgdi:waypoint x="645" y="410"/>
        <omgdi:waypoint x="446" y="410"/>
        <omgdi:waypoint x="446" y="314"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow_9_di" bpmnElement="SequenceFlow_9">
        <omgdi:waypoint x="975" y="295"/>
        <omgdi:waypoint x="1020" y="295"/>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="981" y="275" width="17" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow_10_di" bpmnElement="SequenceFlow_10">
        <omgdi:waypoint x="956" y="314"/>
        <omgdi:waypoint x="956" y="410"/>
        <omgdi:waypoint x="745" y="410"/>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="961" y="358" width="38" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow_11_di" bpmnElement="SequenceFlow_11">
        <omgdi:waypoint x="1120" y="295"/>
        <omgdi:waypoint x="1165" y="295"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
