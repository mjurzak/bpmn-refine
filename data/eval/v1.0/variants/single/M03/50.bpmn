<?xml version='1.0' encoding='UTF-8'?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Process_1" isExecutable="false">
    <task id="Task_1" name="Claim is registered">
      <outgoing>SequenceFlow_2</outgoing>
      <incoming>SequenceFlow_1</incoming>
    </task>
    <task id="Task_2" name="Claim is examined by a claims officer">
      <outgoing>SequenceFlow_6</outgoing>
      <incoming>SequenceFlow_2</incoming>
    </task>
    <task id="Task_3" name="Claims officer writes a settlement recommendation">
      <outgoing>SequenceFlow_3</outgoing>
      <incoming>SequenceFlow_7</incoming>
    </task>
    <task id="Task_4" name="Recommendation is checked by a senior claims officer">
      <outgoing>SequenceFlow_4</outgoing>
      <incoming>SequenceFlow_3</incoming>
    </task>
    <task id="Task_5" name="Senior claims officer marks the claim">
      <outgoing>SequenceFlow_5</outgoing>
      <incoming>SequenceFlow_4</incoming>
    </task>
    <task id="Task_6" name="Claim is sent back">
      <outgoing>SequenceFlow_8</outgoing>
      <incoming>SequenceFlow_10</incoming>
    </task>
    <task id="Task_7" name="Claim handling process proceeds">
      <outgoing>SequenceFlow_11</outgoing>
      <incoming>SequenceFlow_9</incoming>
    </task>
    <exclusiveGateway id="ExclusiveGateway_1">
      <outgoing>SequenceFlow_9</outgoing>
      <outgoing>SequenceFlow_10</outgoing>
      <incoming>SequenceFlow_5</incoming>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_2">
      <outgoing>SequenceFlow_7</outgoing>
      <incoming>SequenceFlow_6</incoming>
      <incoming>SequenceFlow_8</incoming>
    </exclusiveGateway>
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_11</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="Task_2"/>
    <sequenceFlow id="SequenceFlow_3" sourceRef="Task_3" targetRef="Task_4"/>
    <sequenceFlow id="SequenceFlow_4" sourceRef="Task_4" targetRef="Task_5"/>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_5" targetRef="ExclusiveGateway_1"/>
    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_2" targetRef="ExclusiveGateway_2"/>
    <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_2" targetRef="Task_3"/>
    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_6" targetRef="ExclusiveGateway_2"/>
    <sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_1" targetRef="Task_7" name="OK"/>
    <sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_1" targetRef="Task_6" name="Not OK">
      <conditionExpression xsi:type="tFormalExpression">${claimStatus == 'OK'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="SequenceFlow_11" sourceRef="Task_7" targetRef="EndEvent_1"/>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_1">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="Task_1_di" bpmnElement="Task_1">
        <omgdc:Bounds x="155" y="255" width="100" height="80"/>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="178" y="281" width="55" height="24"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_2_di" bpmnElement="Task_2">
        <omgdc:Bounds x="300" y="255" width="100" height="80"/>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="313" y="287" width="75" height="12"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_3_di" bpmnElement="Task_3">
        <omgdc:Bounds x="500" y="255" width="100" height="80"/>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="505" y="275" width="90" height="36"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_4_di" bpmnElement="Task_4">
        <omgdc:Bounds x="645" y="255" width="100" height="80"/>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="650" y="275" width="90" height="36"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_5_di" bpmnElement="Task_5">
        <omgdc:Bounds x="790" y="255" width="100" height="80"/>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="801" y="287" width="79" height="12"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_6_di" bpmnElement="Task_6">
        <omgdc:Bounds x="645" y="370" width="100" height="80"/>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="657" y="402" width="76" height="12"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_7_di" bpmnElement="Task_7">
        <omgdc:Bounds x="1020" y="255" width="100" height="80"/>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="1024" y="275" width="92" height="36"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway_1_di" bpmnElement="ExclusiveGateway_1">
        <omgdc:Bounds x="935" y="275" width="40" height="40"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway_2_di" bpmnElement="ExclusiveGateway_2">
        <omgdc:Bounds x="425" y="275" width="40" height="40"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <omgdc:Bounds x="80" y="280" width="30" height="30"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <omgdc:Bounds x="1165" y="281" width="28" height="28"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow_1_di" bpmnElement="SequenceFlow_1">
        <omgdi:waypoint x="110" y="295"/>
        <omgdi:waypoint x="155" y="295"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow_2_di" bpmnElement="SequenceFlow_2">
        <omgdi:waypoint x="255" y="295"/>
        <omgdi:waypoint x="300" y="295"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow_3_di" bpmnElement="SequenceFlow_3">
        <omgdi:waypoint x="600" y="295"/>
        <omgdi:waypoint x="645" y="295"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow_4_di" bpmnElement="SequenceFlow_4">
        <omgdi:waypoint x="745" y="295"/>
        <omgdi:waypoint x="790" y="295"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow_5_di" bpmnElement="SequenceFlow_5">
