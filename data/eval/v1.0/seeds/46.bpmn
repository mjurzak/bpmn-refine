<?xml version="1.0" ?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Process_1">
    <serviceTask id="ServiceTask_1" name="Read order">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </serviceTask>
    <serviceTask id="ServiceTask_2" name="Check if product is in stock">
      <incoming>SequenceFlow_15</incoming>
      <outgoing>SequenceFlow_3</outgoing>
    </serviceTask>
    <serviceTask id="ServiceTask_3" name="Reorder from wholesaler">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </serviceTask>
    <serviceTask id="ServiceTask_4" name="Waiting until arrives (handling system)">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </serviceTask>
    <serviceTask id="ServiceTask_5" name="Demand delivery delay penalty from the wholesaler">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </serviceTask>
    <manualTask id="ManualTask_1" name="Withdraw the Product from warehouse">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </manualTask>
    <manualTask id="ManualTask_2" name="Register in stock management system">
      <incoming>SequenceFlow_14</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </manualTask>
    <manualTask id="ManualTask_3" name="Check if the whole order is ready for shipment">
      <incoming>SequenceFlow_10</incoming>
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </manualTask>
    <manualTask id="ManualTask_4" name="Packing the products">
      <incoming>SequenceFlow_23</incoming>
      <outgoing>SequenceFlow_21</outgoing>
    </manualTask>
    <manualTask id="ManualTask_5" name="Shipping the order">
      <incoming>SequenceFlow_18</incoming>
      <outgoing>SequenceFlow_13</outgoing>
    </manualTask>
    <manualTask id="ManualTask_6" name="Courier is requested">
      <incoming>SequenceFlow_19</incoming>
      <outgoing>SequenceFlow_22</outgoing>
    </manualTask>
    <exclusiveGateway id="ExclusiveGateway_1" name="Is in stock?">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
      <outgoing>SequenceFlow_5</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_2" name="Arrived after more than ten days?">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_9</outgoing>
      <outgoing>SequenceFlow_17</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_3" name="Order is ready for shipment?">
      <incoming>SequenceFlow_12</incoming>
      <outgoing>SequenceFlow_16</outgoing>
      <outgoing>SequenceFlow_20</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_4">
      <incoming>SequenceFlow_8</incoming>
      <incoming>SequenceFlow_17</incoming>
      <outgoing>SequenceFlow_14</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_5">
      <incoming>SequenceFlow_2</incoming>
      <incoming>SequenceFlow_16</incoming>
      <outgoing>SequenceFlow_15</outgoing>
    </exclusiveGateway>
    <parallelGateway id="ParallelGateway_1">
      <incoming>SequenceFlow_20</incoming>
      <outgoing>SequenceFlow_19</outgoing>
      <outgoing>SequenceFlow_23</outgoing>
    </parallelGateway>
    <parallelGateway id="ParallelGateway_2">
      <incoming>SequenceFlow_21</incoming>
      <incoming>SequenceFlow_22</incoming>
      <outgoing>SequenceFlow_18</outgoing>
    </parallelGateway>
    <startEvent id="StartEvent_1" name="Storage management">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <endEvent id="EndEvent_1" name="Order was shipped">
      <incoming>SequenceFlow_13</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="ServiceTask_1"/>
    <sequenceFlow id="SequenceFlow_2" sourceRef="ServiceTask_1" targetRef="ExclusiveGateway_5"/>
    <sequenceFlow id="SequenceFlow_3" sourceRef="ServiceTask_2" targetRef="ExclusiveGateway_1"/>
