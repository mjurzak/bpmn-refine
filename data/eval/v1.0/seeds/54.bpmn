<?xml version="1.0" ?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Process_1">
    <task id="Task_1" name="INQ transmits the transaction data request">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <task id="Task_2" name="IP checks the request of the INQ">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
    </task>
    <task id="Task_3" name="IP answers the question of the INQ">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </task>
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_4</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="Task_2"/>
    <sequenceFlow id="SequenceFlow_3" sourceRef="Task_2" targetRef="Task_3"/>
    <sequenceFlow id="SequenceFlow_4" sourceRef="Task_3" targetRef="EndEvent_1"/>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape bpmnElement="TextAnnotation_0bshik4" id="TextAnnotation_0bshik4_di">
        <omgdc:Bounds x="120" y="150" width="700" height="55"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="StartEvent_1" id="StartEvent_1_di">
        <omgdc:Bounds x="135" y="280" width="30" height="30"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_1" id="Task_1_di">
        <omgdc:Bounds x="210" y="255" width="100" height="80"/>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="216" y="275" width="89" height="36"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_2" id="Task_2_di">
        <omgdc:Bounds x="380" y="255" width="100" height="80"/>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="391" y="275" width="78" height="36"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_3" id="Task_3_di">
        <omgdc:Bounds x="550" y="255" width="100" height="80"/>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="558" y="275" width="83" height="36"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="EndEvent_1" id="EndEvent_1_di">
        <omgdc:Bounds x="695" y="281" width="28" height="28"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge bpmnElement="SequenceFlow_4" id="SequenceFlow_4_di">
        <omgdi:waypoint x="650" y="295"/>
        <omgdi:waypoint x="695" y="295"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="SequenceFlow_3" id="SequenceFlow_3_di">
        <omgdi:waypoint x="480" y="295"/>
        <omgdi:waypoint x="550" y="295"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="SequenceFlow_2" id="SequenceFlow_2_di">
        <omgdi:waypoint x="310" y="295"/>
        <omgdi:waypoint x="380" y="295"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="SequenceFlow_1" id="SequenceFlow_1_di">
        <omgdi:waypoint x="165" y="295"/>
        <omgdi:waypoint x="210" y="295"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>