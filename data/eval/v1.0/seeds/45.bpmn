      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </manualTask>
    <manualTask id="ManualTask_4" name="customer saves product">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </manualTask>
    <manualTask id="ManualTask_5" name="customer checks if product was already selected">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </manualTask>
    <manualTask id="ManualTask_6" name="customer enters payment data">
      <incoming>SequenceFlow_14</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </manualTask>
    <manualTask id="ManualTask_7" name="customer enters shipping address">
      <incoming>SequenceFlow_15</incoming>
      <outgoing>SequenceFlow_16</outgoing>
    </manualTask>
    <manualTask id="ManualTask_8" name="customer enters an independent billing adress">
      <incoming>SequenceFlow_20</incoming>
      <outgoing>SequenceFlow_17</outgoing>
    </manualTask>
    <exclusiveGateway id="ExclusiveGateway_1" name="succesful login?">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_25</outgoing>
      <outgoing>SequenceFlow_29</outgoing>
