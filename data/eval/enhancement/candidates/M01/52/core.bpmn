<?xml version='1.0' encoding='UTF-8'?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Process_1" isExecutable="false">
    <task id="Task_1" name="MPON sents the dismissal to the MPOO">
      <outgoing>SequenceFlow_3</outgoing>
      <incoming>SequenceFlow_1</incoming>
    </task>
    <task id="Task_3" name="MPOO opposes the dismissal">
      <outgoing>SequenceFlow_6</outgoing>
      <incoming>SequenceFlow_4</incoming>
    </task>
    <task id="Task_4" name="MPOO confirmes the dismissal">
      <outgoing>SequenceFlow_7</outgoing>
      <incoming>SequenceFlow_5</incoming>
    </task>
    <exclusiveGateway id="ExclusiveGateway_1">
      <outgoing>SequenceFlow_4</outgoing>
      <outgoing>SequenceFlow_5</outgoing>
      <incoming>SequenceFlow_3</incoming>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_2">
      <outgoing>SequenceFlow_8</outgoing>
      <incoming>SequenceFlow_6</incoming>
      <incoming>SequenceFlow_7</incoming>
    </exclusiveGateway>
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_8</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="Task_3"/>
    <sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_1" targetRef="Task_4"/>
    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_3" targetRef="ExclusiveGateway_2"/>
    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_4" targetRef="ExclusiveGateway_2"/>
    <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_2" targetRef="EndEvent_1"/>
    <sequenceFlow id="SequenceFlow_3" sourceRef="Task_1" targetRef="ExclusiveGateway_1"/>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_1">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="Task_1_di" bpmnElement="Task_1">
        <omgdc:Bounds x="195" y="285" width="100" height="80"/>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="219" y="311" width="52" height="24"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_3_di" bpmnElement="Task_3">
        <omgdc:Bounds x="520" y="240" width="100" height="80"/>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="536" y="266" width="68" height="24"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_4_di" bpmnElement="Task_4">
        <omgdc:Bounds x="520" y="330" width="100" height="80"/>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="533" y="356" width="74" height="24"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway_1_di" bpmnElement="ExclusiveGateway_1">
        <omgdc:Bounds x="465" y="305" width="40" height="40"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExclusiveGateway_2_di" bpmnElement="ExclusiveGateway_2">
        <omgdc:Bounds x="625" y="305" width="40" height="40"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <omgdc:Bounds x="140" y="310" width="30" height="30"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <omgdc:Bounds x="690" y="311" width="28" height="28"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow_1_di" bpmnElement="SequenceFlow_1">
        <omgdi:waypoint x="170" y="325"/>
        <omgdi:waypoint x="195" y="325"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow_4_di" bpmnElement="SequenceFlow_4">
        <omgdi:waypoint x="486" y="305"/>
        <omgdi:waypoint x="486" y="280"/>
        <omgdi:waypoint x="520" y="280"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow_5_di" bpmnElement="SequenceFlow_5">
        <omgdi:waypoint x="486" y="345"/>
        <omgdi:waypoint x="486" y="370"/>
        <omgdi:waypoint x="520" y="370"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow_6_di" bpmnElement="SequenceFlow_6">
        <omgdi:waypoint x="620" y="280"/>
        <omgdi:waypoint x="646" y="280"/>
        <omgdi:waypoint x="646" y="305"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow_7_di" bpmnElement="SequenceFlow_7">
        <omgdi:waypoint x="620" y="370"/>
        <omgdi:waypoint x="646" y="370"/>
        <omgdi:waypoint x="646" y="345"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow_8_di" bpmnElement="SequenceFlow_8">
        <omgdi:waypoint x="665" y="325"/>
        <omgdi:waypoint x="690" y="325"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow_3_di" bpmnElement="SequenceFlow_3">
        <omgdi:waypoint x="295" y="325"/>
        <omgdi:waypoint x="465" y="325"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
