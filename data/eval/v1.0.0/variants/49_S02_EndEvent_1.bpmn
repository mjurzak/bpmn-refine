    <sequenceFlow id="SequenceFlow_13" sourceRef="Task_9" targetRef="ParallelGateway_2"/>
    <sequenceFlow id="SequenceFlow_14" sourceRef="Task_10" targetRef="ParallelGateway_2"/>
    <sequenceFlow id="SequenceFlow_16" sourceRef="Task_4" targetRef="ExclusiveGateway_4"/>
    <sequenceFlow id="SequenceFlow_17" sourceRef="ExclusiveGateway_1" targetRef="Task_4" name="costs are not acceptable"/>
    <sequenceFlow id="SequenceFlow_18" sourceRef="ExclusiveGateway_1" targetRef="ExclusiveGateway_3" name="costs are acceptable"/>
    <sequenceFlow id="SequenceFlow_19" sourceRef="ExclusiveGateway_2" targetRef="ExclusiveGateway_3" name="error is detected"/>
    <sequenceFlow id="SequenceFlow_20" sourceRef="ExclusiveGateway_2" targetRef="Task_8" name="no error"/>
  </process>
