<?xml version='1.0' encoding='UTF-8'?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Process_1" isExecutable="false">
    <userTask id="UserTask_1" name="Send a report to the fridge service center">
      <outgoing>SequenceFlow_3</outgoing>
      <incoming>SequenceFlow_14</incoming>
    </userTask>
    <userTask id="UserTask_2" name="Rate Service Facility">
      <outgoing>SequenceFlow_1</outgoing>
      <incoming>SequenceFlow_12</incoming>
    </userTask>
    <userTask id="UserTask_3" name="Describe the symptoms">
      <outgoing>SequenceFlow_15</outgoing>
      <incoming>SequenceFlow_9</incoming>
    </userTask>
    <serviceTask id="ServiceTask_1" name="Schedule an appointment for fridge repair">
      <outgoing>SequenceFlow_4</outgoing>
      <incoming>SequenceFlow_8</incoming>
    </serviceTask>
    <serviceTask id="ServiceTask_2" name="Select local service facility">
      <outgoing>SequenceFlow_7</outgoing>
      <incoming>SequenceFlow_3</incoming>
    </serviceTask>
    <manualTask id="ManualTask_1" name="Confirm that fridge is okay">
      <outgoing>SequenceFlow_2</outgoing>
      <incoming>SequenceFlow_11</incoming>
    </manualTask>
    <manualTask id="ManualTask_2" name="Repair the fridge">
      <outgoing>SequenceFlow_6</outgoing>
      <incoming>SequenceFlow_5</incoming>
    </manualTask>
    <manualTask id="ManualTask_3" name="Collect fridge type data">
      <outgoing>SequenceFlow_13</outgoing>
      <incoming>SequenceFlow_10</incoming>
    </manualTask>
    <exclusiveGateway id="ExclusiveGateway_1" name="Submit a rating?">
      <outgoing>SequenceFlow_12</outgoing>
      <outgoing>SequenceFlow_17</outgoing>
      <incoming>SequenceFlow_2</incoming>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_2" name="Additional parts needed?">
      <outgoing>SequenceFlow_11</outgoing>
      <outgoing>SequenceFlow_18</outgoing>
      <incoming>SequenceFlow_6</incoming>
    </exclusiveGateway>
    <exclusiveGateway id="ExclusiveGateway_3">
      <outgoing>SequenceFlow_8</outgoing>
      <incoming>SequenceFlow_7</incoming>
      <incoming>SequenceFlow_18</incoming>
    </exclusiveGateway>
    <parallelGateway id="ParallelGateway_1">
      <outgoing>SequenceFlow_9</outgoing>
      <outgoing>SequenceFlow_10</outgoing>
      <incoming>SequenceFlow_16</incoming>
    </parallelGateway>
    <exclusiveGateway id="ParallelGateway_2">
      <outgoing>SequenceFlow_14</outgoing>
      <incoming>SequenceFlow_13</incoming>
      <incoming>SequenceFlow_15</incoming>
    </exclusiveGateway>
    <startEvent id="StartEvent_1" name="Fridge makes strange noises">
      <outgoing>SequenceFlow_16</outgoing>
    </startEvent>
    <endEvent id="EndEvent_1" name="Repair process over">
      <incoming>SequenceFlow_1</incoming>
      <incoming>SequenceFlow_17</incoming>
    </endEvent>
    <intermediateCatchEvent id="IntermediateCatchEvent_1" name="Wait until service facility arrives">
      <outgoing>SequenceFlow_5</outgoing>
      <incoming>SequenceFlow_4</incoming>
      <timerEventDefinition id="timer_1"/>
    </intermediateCatchEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="UserTask_2" targetRef="EndEvent_1"/>
    <sequenceFlow id="SequenceFlow_2" sourceRef="ManualTask_1" targetRef="ExclusiveGateway_1"/>
    <sequenceFlow id="SequenceFlow_3" sourceRef="UserTask_1" targetRef="ServiceTask_2"/>
    <sequenceFlow id="SequenceFlow_4" sourceRef="ServiceTask_1" targetRef="IntermediateCatchEvent_1"/>
    <sequenceFlow id="SequenceFlow_5" sourceRef="IntermediateCatchEvent_1" targetRef="ManualTask_2"/>
    <sequenceFlow id="SequenceFlow_6" sourceRef="ManualTask_2" targetRef="ExclusiveGateway_2"/>
    <sequenceFlow id="SequenceFlow_7" sourceRef="ServiceTask_2" targetRef="ExclusiveGateway_3"/>
    <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_3" targetRef="ServiceTask_1"/>
    <sequenceFlow id="SequenceFlow_9" sourceRef="ParallelGateway_1" targetRef="UserTask_3"/>
    <sequenceFlow id="SequenceFlow_10" sourceRef="ParallelGateway_1" targetRef="ManualTask_3"/>
    <sequenceFlow id="SequenceFlow_11" sourceRef="ExclusiveGateway_2" targetRef="ManualTask_1" name="No. Fridge is repaired"/>
    <sequenceFlow id="SequenceFlow_12" sourceRef="ExclusiveGateway_1" targetRef="UserTask_2" name="Yes"/>
    <sequenceFlow id="SequenceFlow_13" sourceRef="ManualTask_3" targetRef="ParallelGateway_2"/>
    <sequenceFlow id="SequenceFlow_14" sourceRef="ParallelGateway_2" targetRef="UserTask_1"/>
    <sequenceFlow id="SequenceFlow_15" sourceRef="UserTask_3" targetRef="ParallelGateway_2"/>
    <sequenceFlow id="SequenceFlow_16" sourceRef="StartEvent_1" targetRef="ParallelGateway_1"/>
    <sequenceFlow id="SequenceFlow_17" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_1" name="No"/>
    <sequenceFlow id="SequenceFlow_18" sourceRef="ExclusiveGateway_2" targetRef="ExclusiveGateway_3" name="Yes. Fridge is not repaired"/>
  </process>
